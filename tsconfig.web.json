{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "paths": {
      "~/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    },
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.vue",
    "src/renderer/*.d.ts",
    "src/preload/*.d.ts",
    "src/shared/**/*.ts"
  ]
}
