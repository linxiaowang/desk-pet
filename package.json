{
  "name": "desk-pet",
  "type": "module",
  "version": "1.0.4",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "description": "透明置顶的桌面宠物",
  "author": "",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --config electron-builder.json",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.json",
    "dist:win": "electron-vite build && electron-builder --win --x64 --config electron-builder.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "generate-pet": "tsx scripts/generate-default-pet.ts"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "electron-updater": "^6.8.9",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^24.5.2",
    "@unocss/eslint-plugin": "^66.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-format": "^1.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "unocss": "^66.5.2",
    "unplugin-auto-import": "^20.2.0",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
