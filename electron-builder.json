{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "dev.deskpet.app",
  "productName": "DeskPet",
  "icon": "build/icon.png",
  "asar": true,
  "directories": {
    "output": "release"
  },
  "files": [
    "out"
  ],
  "extraResources": [
    {
      "from": "resources/pets",
      "to": "pets"
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "linxiaowang",
    "repo": "desk-pet"
  },
  "mac": {
    "identity": null,
    "gatekeeperAssess": false,
    "hardenedRuntime": false,
    "target": [
      "dmg",
      "zip"
    ],
    "artifactName": "${productName}-Mac.${ext}"
  },
  "win": {
    "target": [
      "nsis"
    ],
    "artifactName": "${productName}-Windows.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false
  }
}
