{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "dev.deskpet.app",
  "productName": "DeskPet",
  "icon": "build/icon.png",
  "asar": true,
  "directories": {
    "output": "release"
  },
  "files": [
    "out"
  ],
  "extraResources": [
    {
      "from": "resources/pets",
      "to": "pets"
    }
  ],
  "mac": {
    "identity": null,
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac.${ext}"
  },
  "win": {
    "target": [
      "portable"
    ],
    "artifactName": "${productName}-Windows.${ext}"
  }
}
